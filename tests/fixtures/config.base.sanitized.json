{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun0",
      "interface_name": "tun0",
      "stack": "gvisor",
      "auto_route": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "vless",
      "tag": "overfog",
      "server": "example.invalid",
      "server_port": 443,
      "uuid": "00000000-0000-4000-8000-000000000001",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "example.invalid",
        "utls": {
          "enabled": true,
          "fingerprint": "qq"
        },
        "reality": {
          "enabled": true,
          "public_key": "SANITIZED_PUBLIC_KEY",
          "short_id": "00000000"
        }
      }
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic",
          "bittorrent"
        ],
        "timeout": "1s"
      },
      {
        "port": 53,
        "network": [
          "tcp",
          "udp"
        ],
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          ".ru",
          ".su",
          ".by"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-category-ru"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geoip-ru"
        ],
        "outbound": "direct"
      },
      {
        "ip_cidr": [
          "17.0.0.0/8"
        ],
        "outbound": "direct"
      },
      {
        "protocol": "bittorrent",
        "outbound": "direct"
      },
      {
        "ip_cidr": [
          "192.168.8.0/24"
        ],
        "outbound": "direct"
      }
    ],
    "final": "overfog"
  }
}
